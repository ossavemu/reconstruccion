# Anthropic API key used by the damage estimation endpoint (/api/estimar)
ANTHROPIC_API_KEY=

# Turso (libSQL) database that stores registrations and votes
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Resend API key used to email the voting link (optional; if missing,
# the link is shown on screen instead of being emailed)
RESEND_API_KEY=

# Verified sender for Resend (falls back to onboarding@resend.dev)
EMAIL_FROM=Reconstruccion <onboarding@resend.dev>

# Optional reply-to address so answers reach your personal inbox
EMAIL_REPLY_TO=
