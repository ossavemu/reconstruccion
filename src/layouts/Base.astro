---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Iniciativa humanitaria para estimar daños y apoyar la reconstrucción tras el terremoto.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">Inicio</a>
        <nav class="site-nav">
          <a href="/estimar">Estimar daños</a>
          <a href="/reconstruccion">Registro</a>
          <a href="/votar">Votación</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Iniciativa humanitaria y gratuita para sobrevivientes del terremoto
          del 10 de agosto de 2026 en Colombia. Las estimaciones generadas por
          IA son preliminares y no reemplazan una inspección técnica
          profesional.
        </p>
      </div>
    </footer>
  </body>
</html>
