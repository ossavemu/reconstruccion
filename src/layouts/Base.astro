---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Iniciativa humanitaria de orientación técnica para afectados por el terremoto.",
} = Astro.props;

// Astro.site comes from astro.config.mjs; fall back to the request URL in dev.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">Inicio</a>
        <nav class="site-nav">
          <a href="/reconstruccion">Registro</a>
          <a href="/votar">Votación</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Iniciativa humanitaria y gratuita para sobrevivientes del terremoto
          del 10 de agosto de 2026 en Colombia.
        </p>
        <p>
          Si tiene cualquier información adicional o pregunta, escriba a
          <a href="mailto:osanvem@gmail.com">osanvem@gmail.com</a>.
        </p>
        <p>
          El código de esta plataforma es abierto:
          <a
            href="https://github.com/ossavemu/reconstruccion"
            target="_blank"
            rel="noopener">github.com/ossavemu/reconstruccion</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
